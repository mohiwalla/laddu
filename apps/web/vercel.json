{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": null,
	"installCommand": "bunx bun@1.4.4 install --frozen-lockfile",
	"buildCommand": "bunx bun@1.4.4 run build.ts",
	"outputDirectory": "dist",
	"headers": [
		{
			"source": "/install.sh",
			"headers": [
				{
					"key": "Content-Type",
					"value": "text/x-shellscript; charset=utf-8"
				}
			]
		}
	]
}
