#!/usr/bin/env python3
"""
dot's long-term memory about one person: two small files loaded into every new conversation.
Design adapted from Hermes Agent's memory tool (MIT License, Copyright (c) Nous Research):
capped stores, entries separated by a line with "§", and writes refused if they look like
prompt injection, since memory is fed back into future prompts.

  memory show
  memory add <user|notes> "<entry>"
  memory replace <user|notes> "<text from one entry>" "<new entry>"
  memory remove <user|notes> "<text from one entry>"

user  = who the person is: name, role, team, preferences, how they like answers.
notes = your own notes: their environment, standing conventions, lessons learned.
"""
import os
import re
import sys
import unicodedata
from pathlib import Path

DIR = Path(os.environ.get("DOT_MEMORY_DIR") or Path.home() / "memory")
STORES = {
    "user": ("USER.md", 1375, "USER PROFILE (who they are)"),
    "notes": ("MEMORY.md", 2200, "MEMORY (your notes)"),
}
SEP = "\n§\n"

_F = r"(?:\w+\s+){0,8}"
THREATS = [
    (rf"ignore\s+{_F}(previous|all|above|prior)\s+{_F}instructions", "prompt injection"),
    (r"system\s+prompt\s+override", "prompt override"),
    (rf"disregard\s+{_F}(your|all|any)\s+{_F}(instructions|rules|guidelines)", "disregarding rules"),
    (rf"do\s+not\s+{_F}tell\s+{_F}the\s+user", "hiding things from the user"),
    (rf"you\s+are\s+{_F}now\s+(a|an|the)\s+", "identity hijack"),
    (rf"pretend\s+{_F}(you\s+are|to\s+be)\s+", "identity hijack"),
    (r"(curl|wget)\s+[^\n]*\$\{?\w*(KEY|TOKEN|SECRET|PASSWORD|CREDENTIAL)S?\b", "secret exfiltration"),
    (r"cat\s+[^\n]*(\.env|credentials|\.netrc|\.pgpass|\.npmrc|\.pypirc)", "reading secrets"),
    (r"(send|post|upload|transmit)\s+[^\n]*\s+(to|at)\s+https?://", "sending data to a URL"),
    (rf"(include|output|print|share)\s+{_F}(conversation|chat\s+history|previous\s+messages|full\s+context)", "leaking context"),
]


def fail(message):
    print(f"error: {message}", file=sys.stderr)
    sys.exit(1)


def load(store):
    path = DIR / STORES[store][0]
    raw = path.read_text(encoding="utf-8") if path.exists() else ""
    return [entry.strip() for entry in raw.split("§") if entry.strip()]


def size(entries):
    return len(SEP.join(entries))


def usage(store, entries):
    limit = STORES[store][1]
    return f"{size(entries) * 100 // limit}% — {size(entries):,}/{limit:,} chars"


def render(store, entries):
    bar = "═" * 46
    return f"{bar}\n{STORES[store][2]} [{usage(store, entries)}]\n{bar}\n{SEP.join(entries)}"


def listing(entries):
    return "\n".join(f"  {i}. {entry}" for i, entry in enumerate(entries, 1)) or "  (empty)"


def save(store, entries):
    limit = STORES[store][1]
    if size(entries) > limit:
        current = load(store)
        fail(
            f"{store} memory would be {size(entries):,}/{limit:,} chars. Free space first: remove or "
            f"shorten stale entries, then add. Current entries:\n{listing(current)}"
        )
    DIR.mkdir(parents=True, exist_ok=True)
    path = DIR / STORES[store][0]
    tmp = path.with_suffix(".tmp")
    tmp.write_text(SEP.join(entries) + ("\n" if entries else ""), encoding="utf-8")
    os.replace(tmp, path)
    print(f"Saved. {store} memory: {usage(store, entries)}, {len(entries)} entries. Done, don't repeat it.")


def check(entry):
    entry = entry.strip()
    if not entry:
        fail("empty entry")
    if "§" in entry:
        fail('entries can\'t contain "§"')
    if any(unicodedata.category(ch) == "Cf" for ch in entry):
        fail("entry contains invisible characters")
    for pattern, what in THREATS:
        if re.search(pattern, entry, re.IGNORECASE):
            fail(f"refused: this looks like {what}, and memory is fed into future prompts")
    return entry


def find(entries, text):
    matches = [i for i, entry in enumerate(entries) if text.strip() and text.strip() in entry]
    if len(matches) != 1:
        found = "no entry" if not matches else f"{len(matches)} entries"
        fail(f"{found} contains that text; quote text from exactly one entry. Current entries:\n{listing(entries)}")
    return matches[0]


def main(args):
    if args[:1] == ["show"]:
        blocks = [render(store, entries) for store in STORES if (entries := load(store))]
        print("\n\n".join(blocks) if blocks else "(memory is empty)")
        return
    if len(args) < 3 or args[0] not in ("add", "replace", "remove") or args[1] not in STORES:
        fail(__doc__.split("\n\n")[1].strip())
    action, store, text = args[0], args[1], args[2]
    entries = load(store)
    if action == "add":
        entry = check(text)
        if entry in entries:
            print("Already saved; nothing to do.")
            return
        save(store, entries + [entry])
    elif action == "replace":
        if len(args) != 4:
            fail('usage: memory replace <user|notes> "<text from one entry>" "<new entry>"')
        entries[find(entries, text)] = check(args[3])
        save(store, entries)
    else:
        del entries[find(entries, text)]
        save(store, entries)


if __name__ == "__main__":
    main(sys.argv[1:])
