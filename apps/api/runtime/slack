#!/usr/bin/env python3
"""
Slack, for the person you're working for: find people in the workspace and DM them. Once they've
connected their Slack account, a DM goes out as them, in their own DM with that person, exactly as
if they typed it. Otherwise (or with --from-dot) it comes from dot, headed "<person> asked me to
send you this:".

  slack status | connect | disconnect      their Slack connection (connect DMs them a link)
  slack find "<name or email>"             people in the workspace: Slack ID, name, title, email
  slack dm <@U123 | U123 | email> "text" [--from-dot]
  slack methods [method] | capabilities
  slack api <method> '<JSON arguments>' [--as auto|user|dot]
  slack search "in:general decision" [--files] [--page 1]
  slack channels | history <channel> | thread <channel> <ts>
  slack send <channel> "text" [--thread <ts>] [--as auto|user|dot]
  slack upload <channel> <path> [--thread <ts>] | download <file ID> <path>
  slack automate welcome <channel> "Welcome <@{user}>!"
  slack automate add '<JSON rule>' | list | history | remove|enable|disable <id>
  slack form '<JSON form>'
  slack ask "<question>" [--choice "A" --choice "B" ...] [--multiple | --buttons] [--no-other]
  slack ask '<JSON question>'                              a form: several fields in a popup

ask puts a question to the person in this thread and waits for their answer. Choices show as radio
buttons (checkboxes with --multiple; a dropdown past 10 choices, up to 100), with a Send button and
"Something else..." for a typed answer unless --no-other. --buttons: up to 5 choices as one-click
buttons. No choices: a typed answer. Use it instead of asking in your reply when you need their
answer to carry on. It waits up to 10 minutes; if they haven't answered by then, end your turn
saying you're waiting, and their answer comes to you later as a new message.

A JSON question: {"text": "...", "title": "popup title, 24 max", "fields": [...]} (or choices,
multiple, buttons, other as above). Each field: {"label", "type", "name", "required" (default
true), "hint", "placeholder", "initial"} and per type:
  text (multiline, min, max length) | number (decimal, min, max) | email | url
  select | multiselect (options, up to 100; max picks) | radio | checkboxes (options, up to 10)
  date (initial YYYY-MM-DD) | time (HH:MM) | datetime (ISO)
  user | users | channel | channels | conversation | conversations (initial: IDs; max picks)
  file (max files, up to 10; filetypes) | richtext
The answer to a form is JSON by field label: IDs for people and channels, ISO for date-times,
{id, name} for files (fetch them with `slack download`), null for fields left empty.

JSON arguments may be read from @filename. Run slack methods <method> for required/optional
arguments and token requirements. Results include pagination cursors; continue explicitly.
Free history is limited to 90 days. Lists, Workflow Builder and paid agent surfaces aren't tools.

Use IDs from "People here" or `slack find`; never guess one. At most 20 DMs an hour per person.
"""
import argparse
import json
import os
import sys
import urllib.error
import urllib.request
import urllib.parse

API = os.environ.get("DOT_API")
CALLER = os.environ.get("DOT_CALLER")


def call(path, body=None, method="POST"):
    if not API or not CALLER:
        sys.exit("error: Slack isn't available here (no connection to the bot in this turn).")
    request = urllib.request.Request(
        f"{API}{path}",
        method=method,
        data=json.dumps(body).encode() if body is not None else None,
        headers={"x-dot-caller": CALLER, "content-type": "application/json"},
    )
    try:
        with urllib.request.urlopen(request, timeout=60) as response:
            print(json.load(response)["text"])
    except urllib.error.HTTPError as error:
        try:
            message = json.load(error)["text"]
        except Exception:
            message = f"HTTP {error.code}"
        sys.exit(f"error: {message}")
    except urllib.error.URLError as error:
        sys.exit(f"error: couldn't reach the bot ({error.reason}).")


def ask(body):
    if not API or not CALLER:
        sys.exit("error: Slack isn't available here (no connection to the bot in this turn).")
    headers = {"x-dot-caller": CALLER, "content-type": "application/json"}

    def send(request):
        try:
            with urllib.request.urlopen(request, timeout=90) as response:
                return json.load(response)
        except urllib.error.HTTPError as error:
            try:
                message = json.load(error)["text"]
            except Exception:
                message = f"HTTP {error.code}"
            sys.exit(f"error: {message}")
        except urllib.error.URLError as error:
            sys.exit(f"error: couldn't reach the bot ({error.reason}).")

    question = send(urllib.request.Request(f"{API}/slack/ask", method="POST", data=json.dumps(body).encode(), headers=headers))["text"]
    print("Asked in the thread; waiting for their answer...", flush=True)
    while True:
        result = send(urllib.request.Request(f"{API}/slack/ask?{urllib.parse.urlencode({'id': question})}", headers=headers))
        if result["status"] == "answered":
            print(f"Their answer: {result['answer']}")
            return
        if result["status"] == "later":
            print("No answer within 10 minutes. The question stays open in the thread: end your turn now, saying you're waiting for their answer. When they answer, it comes to you as a new message.")
            return
        if result["status"] == "gone":
            sys.exit("error: the question is no longer open.")


def json_input(value):
    try:
        if value.startswith("@"):
            with open(value[1:], encoding="utf-8") as source:
                return json.load(source)
        return json.loads(value)
    except (ValueError, OSError) as error:
        sys.exit(f"error: invalid JSON input ({error}).")


def file_transfer(path, destination=None, upload=None):
    if not API or not CALLER:
        sys.exit("error: Slack isn't available in this turn.")
    data = None
    if upload:
        try:
            with open(upload, "rb") as source:
                data = source.read(50 * 1024 * 1024 + 1)
            if not data or len(data) > 50 * 1024 * 1024:
                sys.exit("error: file must be between 1 byte and 50 MB.")
        except OSError as error:
            sys.exit(f"error: {error}")
    request = urllib.request.Request(f"{API}{path}", method="PUT" if upload else "GET", data=data,
                                     headers={"x-dot-caller": CALLER, "content-type": "application/octet-stream"})
    try:
        with urllib.request.urlopen(request, timeout=120) as response:
            if destination:
                # Exclusive creation avoids silently overwriting a workspace file.
                with open(destination, "xb") as target:
                    while chunk := response.read(65536):
                        target.write(chunk)
                print(f"Downloaded to {destination}")
            else:
                print(json.load(response)["text"])
    except urllib.error.HTTPError as error:
        try:
            message = json.load(error)["text"]
        except Exception:
            message = f"HTTP {error.code}"
        sys.exit(f"error: {message}")
    except (OSError, urllib.error.URLError) as error:
        sys.exit(f"error: {error}")


def main():
    parser = argparse.ArgumentParser(prog="slack", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    commands = parser.add_subparsers(dest="command", required=True)
    for name in ("status", "connect", "disconnect"):
        commands.add_parser(name)
    find = commands.add_parser("find")
    find.add_argument("query")
    dm = commands.add_parser("dm")
    dm.add_argument("to")
    dm.add_argument("text")
    dm.add_argument("--from-dot", action="store_true", help="send from dot instead of as them")
    methods = commands.add_parser("methods")
    methods.add_argument("method", nargs="?")
    commands.add_parser("capabilities")
    api = commands.add_parser("api")
    api.add_argument("method")
    api.add_argument("arguments", nargs="?", default="{}")
    api.add_argument("--as", dest="identity", choices=["auto", "user", "dot"], default="auto")
    search = commands.add_parser("search")
    search.add_argument("query")
    search.add_argument("--files", action="store_true")
    search.add_argument("--page", type=int, default=1)
    channels = commands.add_parser("channels")
    channels.add_argument("--cursor")
    for name in ("history", "thread"):
        read = commands.add_parser(name)
        read.add_argument("channel")
        if name == "thread":
            read.add_argument("ts")
        read.add_argument("--cursor")
        read.add_argument("--limit", type=int, default=50)
        read.add_argument("--oldest")
        read.add_argument("--latest")
    send = commands.add_parser("send")
    send.add_argument("channel")
    send.add_argument("text")
    send.add_argument("--thread")
    send.add_argument("--as", dest="identity", choices=["auto", "user", "dot"], default="auto")
    upload = commands.add_parser("upload")
    upload.add_argument("channel")
    upload.add_argument("path")
    upload.add_argument("--thread")
    download = commands.add_parser("download")
    download.add_argument("file")
    download.add_argument("path")
    form = commands.add_parser("form")
    form.add_argument("definition")
    question = commands.add_parser("ask")
    question.add_argument("text")
    question.add_argument("--choice", action="append", default=[])
    question.add_argument("--multiple", action="store_true", help="let them tick several choices")
    question.add_argument("--buttons", action="store_true", help="choices as one-click buttons")
    question.add_argument("--no-other", action="store_true", help="no typed answer besides the choices")
    automate = commands.add_parser("automate")
    automation_commands = automate.add_subparsers(dest="operation", required=True)
    welcome = automation_commands.add_parser("welcome")
    welcome.add_argument("channel")
    welcome.add_argument("text")
    add = automation_commands.add_parser("add")
    add.add_argument("rule")
    for name in ("list", "history"):
        automation_commands.add_parser(name)
    for name in ("remove", "enable", "disable"):
        automation_commands.add_parser(name).add_argument("id")
    args = parser.parse_args()

    if args.command == "status":
        call("/slack/status", method="GET")
    elif args.command == "connect":
        call("/slack/connect", {})
    elif args.command == "disconnect":
        call("/slack/connect", method="DELETE")
    elif args.command == "find":
        call("/slack/find", {"query": args.query})
    elif args.command == "dm":
        call("/slack/dm", {"to": args.to, "text": args.text, "fromDot": args.from_dot})
    elif args.command in ("methods", "capabilities"):
        query = urllib.parse.urlencode({"method": args.method}) if args.command == "methods" and args.method else ""
        call(f"/slack/{args.command}?{query}", method="GET")
    elif args.command == "api":
        call("/slack/api", {"method": args.method, "args": json_input(args.arguments), "as": args.identity})
    elif args.command == "search":
        call("/slack/api", {"method": "search.files" if args.files else "search.messages", "args": {"query": args.query, "count": 50, "page": args.page}, "as": "user"})
    elif args.command == "channels":
        call("/slack/api", {"method": "conversations.list", "args": {"limit": 100, "exclude_archived": True, **({"cursor": args.cursor} if args.cursor else {})}})
    elif args.command in ("history", "thread"):
        parameters = {"channel": args.channel, "limit": args.limit}
        for key in ("cursor", "oldest", "latest"):
            if getattr(args, key):
                parameters[key] = getattr(args, key)
        if args.command == "thread":
            parameters["ts"] = args.ts
        call("/slack/api", {"method": "conversations.replies" if args.command == "thread" else "conversations.history", "args": parameters})
    elif args.command == "send":
        parameters = {"channel": args.channel, "text": args.text}
        if args.thread:
            parameters["thread_ts"] = args.thread
        call("/slack/api", {"method": "chat.postMessage", "args": parameters, "as": args.identity})
    elif args.command == "upload":
        query = urllib.parse.urlencode({"channel": args.channel, "filename": os.path.basename(args.path), **({"thread_ts": args.thread} if args.thread else {})})
        file_transfer(f"/slack/upload?{query}", upload=args.path)
    elif args.command == "download":
        file_transfer("/slack/download?" + urllib.parse.urlencode({"file": args.file}), destination=args.path)
    elif args.command == "form":
        call("/slack/form", json_input(args.definition))
    elif args.command == "ask":
        if args.text.lstrip().startswith("{") or args.text.startswith("@"):
            ask(json_input(args.text))
        else:
            ask({"text": args.text, "choices": args.choice, "multiple": args.multiple, "buttons": args.buttons, "other": not args.no_other})
    elif args.command == "automate":
        if args.operation == "welcome":
            body = {"operation": "add", "event": "member_joined_channel", "channel": args.channel, "action": "message", "text": args.text}
        elif args.operation == "add":
            body = {**json_input(args.rule), "operation": "add"}
        else:
            body = {"operation": args.operation, **({"id": args.id} if hasattr(args, "id") else {})}
        call("/slack/automate", body)


if __name__ == "__main__":
    main()
