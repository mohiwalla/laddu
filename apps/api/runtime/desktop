#!/usr/bin/env python3
"""
dot's own computer: an XFCE desktop on a virtual display (KasmVNC), started when first needed.
Codex drives it through `desktop mcp`, an MCP server registered in its config; people watch it
(and later take over) in the browser through KasmVNC's web viewer, which the bot proxies.

  desktop link ["<why>"]  privately send the person a link to watch your computer, and take control
                          from it (e.g. so they can sign in to a site themselves)
  desktop start     start the desktop if it isn't running
  desktop stop      stop it (apps close; files and the browser profile stay)
  desktop status    running or not, and how long since the last action
  desktop exec [--] <command> [args...]  run a command with this desktop's display and session
  desktop mcp       MCP server on stdin/stdout (used by Codex)
  desktop control on|off  the person has taken control / handed it back (set by the bot's viewer)
  desktop events    dot's pointer position and actions as JSON lines, for the viewer's dot cursor
  desktop check <host>  can the tools drive that computer of the person's (over SSH)? Says what's
                          missing there and the commands that fix it

The same tools drive the person's own computers when given `machine` (an SSH host): see the
"other computers" section below and runtime/desktop-agent.py, the half that runs over there.

While the person is in control, the tools wait (up to HANDBACK_WAIT_S per call) instead of acting,
and an action interrupted by a hand-back isn't done: the screen may have changed under it.

The screen is the size of the person's browser window while they watch (the viewer asks for it),
and keeps that size after. Codex sees it at most MODEL_BOX: screenshots are scaled down to fit and
its coordinates scaled back up, so a large window doesn't cost more or shrink what Codex reads.
An action aimed at a screen that has changed size since Codex last saw it isn't done either.

Control borrows from computer-use-linux (agent-sh, MIT): one call returns a screenshot together
with the on-screen controls from the accessibility tree (AT-SPI), so clicks can target a named
button instead of guessing pixels; input goes through the X server (xdotool) like a real mouse
and keyboard, so browser UI, autofill, extensions and native dialogs work like any other window.
"""
import base64
import json
import os
import secrets
import signal
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

DISPLAY = ":1"
START_SIZE = (1280, 800)  # until a viewer asks for its own
MODEL_BOX = (1280, 800)  # the largest screenshot Codex is sent
VIEWER_PORT = 6901
STATE = Path.home() / ".desktop"
ENV_FILE = STATE / "env.json"
VIEWER_FILE = STATE / "viewer.json"
ACTIVITY = STATE / "last-action"
LOG = STATE / "log"
# Touched every 10 s while the person has control (their viewer page, through the bot); older than
# CONTROL_STALE_S counts as returned, so a closed tab or a bot restart can't leave dot waiting.
CONTROL = STATE / "person-in-control"
CONTROL_STALE_S = 30
HANDBACK_WAIT_S = 75  # under Codex's 90 s tool timeout
# What dot does, for the viewer to show on its own cursor (a click ripple, "typing…"); the pointer
# position itself is read from X by `desktop events`.
EVENTS = STATE / "events"
EVENTS_MAX_BYTES = 64_000

# Controls worth listing; everything else is read from the screenshot.
INTERACTIVE = {
    "button", "push button", "toggle button", "switch", "check box", "radio button", "link", "entry",
    "password text", "combo box", "menu item", "check menu item", "radio menu item",
    "page tab", "list item", "slider", "spin button", "menu", "icon", "tree item",
    "table cell", "text", "terminal", "heading",
}
TREE_BUDGET_S = 3.0
TREE_MAX_NODES = 4000
TREE_MAX_ELEMENTS = 150
TREE_MAX_CHILDREN = 200  # per node: past this it's data (rows, cells), which the screenshot shows


def run(*cmd, env=None, check=True, capture=True):
    return subprocess.run(
        cmd, env=env, check=check, stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.PIPE if capture else None,
    )


def x_running():
    return Path(f"/tmp/.X11-unix/X{DISPLAY[1:]}").exists() and run(
        "xdpyinfo", "-display", DISPLAY, check=False
    ).returncode == 0


def session_env():
    env = dict(os.environ)
    if ENV_FILE.exists():
        env.update(json.loads(ENV_FILE.read_text()))
    env["DISPLAY"] = DISPLAY
    env.setdefault("MAGICK_THREAD_LIMIT", "2")
    env.setdefault("OMP_NUM_THREADS", "2")
    return env


def spawn(cmd, env, log):
    return subprocess.Popen(
        cmd, env=env, stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True,
    )


def start():
    if x_running() and ENV_FILE.exists():
        return False
    STATE.mkdir(mode=0o700, exist_ok=True)
    log = open(LOG, "ab")

    # Two viewer logins, enforced by the VNC server itself: "watch" can only look, "drive" can
    # also use the mouse and keyboard. The bot reads them from viewer.json to proxy the web viewer.
    if not VIEWER_FILE.exists():
        logins = {"watch": secrets.token_urlsafe(18), "drive": secrets.token_urlsafe(18)}
        VIEWER_FILE.write_text(json.dumps({**logins, "port": VIEWER_PORT}))
        VIEWER_FILE.chmod(0o600)
    logins = json.loads(VIEWER_FILE.read_text())
    passwd = Path.home() / ".kasmpasswd"
    passwd.unlink(missing_ok=True)
    for user, rights in (("watch", "-r"), ("drive", "-rw")):
        secret = logins[user]
        subprocess.run(
            ["kasmvncpasswd", "-u", user, rights, str(passwd)],
            input=f"{secret}\n{secret}\n".encode(), check=True, capture_output=True,
        )

    if not x_running():
        Path(f"/tmp/.X11-unix/X{DISPLAY[1:]}").unlink(missing_ok=True)
        Path(f"/tmp/.X{DISPLAY[1:]}-lock").unlink(missing_ok=True)
        spawn([
            "Xvnc", DISPLAY, "-geometry", "{}x{}".format(*START_SIZE), "-depth", "24",
            "-websocketPort", str(VIEWER_PORT), "-interface", "0.0.0.0",
            "-httpd", "/usr/share/kasmvnc/www", "-sslOnly", "0", "-SecurityTypes", "None",
            "-rfbport", "-1", "-KasmPasswordFile", str(passwd), "-AlwaysShared",
            # The viewer sizes the screen to its window (see the module docstring for coordinates).
            "-AcceptSetDesktopSize", "1", "-FrameRate", "24",
            # No cursor of its own (in the picture or sent to viewers): the viewer draws dot's, always
            # the same arrow, and people use their own cursor when they take control.
            "-nocursor",
        ], os.environ, log)
        for _ in range(50):
            if x_running():
                break
            time.sleep(0.1)
        else:
            sys.exit(f"error: the display didn't start (see {LOG})")

    # One session bus for the desktop and its apps; the accessibility bus hangs off it.
    out = run("dbus-launch", "--sh-syntax", env={**os.environ, "DISPLAY": DISPLAY}).stdout.decode()
    bus = {}
    for line in out.splitlines():
        if "=" in line:
            key, _, value = line.rstrip(";").partition("=")
            bus[key] = value.strip("'")
    env = {
        "DBUS_SESSION_BUS_ADDRESS": bus["DBUS_SESSION_BUS_ADDRESS"],
        "ACCESSIBILITY_ENABLED": "1",  # Chromium exposes pages to AT-SPI
        "GTK_MODULES": "gail:atk-bridge",
        "NO_AT_BRIDGE": "0",
    }
    ENV_FILE.write_text(json.dumps(env))
    full = session_env()
    adopt_look(full)
    spawn(["xfce4-session"], full, log)
    run("xset", "s", "off", "-dpms", env=full, check=False)
    # No bell: the web viewer plays every one as a sound (apps ring it on typos, empty searches…).
    run("xset", "b", "off", env=full, check=False)
    for _ in range(50):  # until the window manager is up
        if run("wmctrl", "-m", env=full, check=False).returncode == 0:
            break
        time.sleep(0.2)
    set_fonts(full)
    touch()
    return True


# XFCE's own font settings (the image's fontconfig covers pages and apps): Inter, JetBrains Mono,
# grayscale antialiasing. Set on every start, since a person's saved settings can hold empty
# values that would otherwise win over the image's defaults.
XFCE_FONTS = [
    ("xsettings", "/Gtk/FontName", "string", "Inter Variable 10"),
    ("xsettings", "/Gtk/MonospaceFontName", "string", "JetBrains Mono 10"),
    ("xsettings", "/Xft/Antialias", "int", "1"),
    ("xsettings", "/Xft/Hinting", "int", "1"),
    ("xsettings", "/Xft/HintStyle", "string", "hintslight"),
    ("xsettings", "/Xft/RGBA", "string", "none"),
    ("xfwm4", "/general/title_font", "string", "Inter Variable Semi-Bold 9"),
]


# The image's look (Dockerfile) is XFCE's system default, but homes from before it saved XFCE's
# stock values, which win over it. Once per home, before the session starts, drop the ones still
# stock so the image's show through; anything a person chose stays.
LOOK_MARK = STATE / "look-v1"
STOCK_LOOK = [
    ("xsettings", "/Net/ThemeName", {"", "Xfce", "Adwaita"}),
    ("xsettings", "/Net/IconThemeName", {"", "Tango", "Adwaita"}),
    ("xfwm4", "/general/theme", {"Default"}),
]


def adopt_look(env):
    if LOOK_MARK.exists():
        return
    for channel, prop, stock in STOCK_LOOK:
        got = run("xfconf-query", "-c", channel, "-p", prop, env=env, check=False)
        if got.returncode != 0 or got.stdout.decode().strip() in stock:
            run("xfconf-query", "-c", channel, "-p", prop, "-r", env=env, check=False)
    # Debian's stock panels (a top bar and a dock ending in a directory menu) → the image's one bar.
    got = run("xfconf-query", "-c", "xfce4-panel", "-p", "/plugins/plugin-18", env=env, check=False)
    if got.stdout.decode().strip() == "directorymenu":
        run("xfconf-query", "-c", "xfce4-panel", "-p", "/", "-r", "-R", env=env, check=False)
    LOOK_MARK.touch()


def set_fonts(env):
    for channel, prop, kind, value in XFCE_FONTS:
        run("xfconf-query", "-c", channel, "-p", prop, "-r", env=env, check=False)
        run("xfconf-query", "-c", channel, "-p", prop, "-n", "-t", kind, "-s", value, env=env, check=False)


def stop():
    run("pkill", "-u", str(os.getuid()), "-f", "xfce4-session|xfwm4|xfce4-panel|xfdesktop|chromium|Thunar|dbus-daemon|at-spi", check=False)
    run("pkill", "-u", str(os.getuid()), "-x", "Xvnc", check=False)
    ENV_FILE.unlink(missing_ok=True)


def touch():
    ACTIVITY.write_text(str(int(time.time())))


def emit(kind, **fields):
    try:
        if EVENTS.exists() and EVENTS.stat().st_size > EVENTS_MAX_BYTES:
            EVENTS.write_text("")
        with open(EVENTS, "a") as f:
            f.write(json.dumps({"t": kind, **fields}) + "\n")
    except OSError:
        pass


def pointer_at(env):
    out = run("xdotool", "getmouselocation", "--shell", env=env, check=False).stdout.decode()
    found = dict(line.split("=", 1) for line in out.split() if "=" in line)
    if "X" in found and "Y" in found:
        return int(found["X"]), int(found["Y"])
    return None


def events():
    """Streams {"t": "at", x, y} when the pointer moves, and what dot does, until stdout closes."""
    STATE.mkdir(mode=0o700, exist_ok=True)
    EVENTS.touch()
    feed = open(EVENTS)
    feed.seek(0, 2)
    last = None
    try:
        while True:
            lines = []
            if x_running():
                at = pointer_at(session_env())
                if at and at != last:
                    last = at
                    lines.append(json.dumps({"t": "at", "x": at[0], "y": at[1]}))
            if feed.tell() > EVENTS.stat().st_size:
                feed.seek(0)  # emptied by emit()
            lines += [line.strip() for line in feed.readlines() if line.strip()]
            if lines:
                sys.stdout.write("\n".join(lines) + "\n")
                sys.stdout.flush()
            time.sleep(0.12)
    except (BrokenPipeError, KeyboardInterrupt):
        pass


def person_in_control():
    try:
        return time.time() - CONTROL.stat().st_mtime < CONTROL_STALE_S
    except FileNotFoundError:
        return False


def control(state):
    if state == "on":
        STATE.mkdir(mode=0o700, exist_ok=True)
        CONTROL.touch()
    elif state == "off":
        CONTROL.unlink(missing_ok=True)
    else:
        sys.exit("usage: desktop control on|off")


def status():
    if not x_running():
        return "stopped"
    idle = int(time.time()) - int(ACTIVITY.read_text() or 0) if ACTIVITY.exists() else -1
    return f"running, idle {idle}s"


# ---- observing ----------------------------------------------------------------------------

def screen_size():
    out = run("xdotool", "getdisplaygeometry", env=session_env()).stdout.decode().split()
    return int(out[0]), int(out[1])


# The screen as Codex last saw it: its real size, and the scale of Codex's coordinates to it.
VIEW = None


def look():
    """Takes the screen's current size as what Codex sees next."""
    global VIEW
    width, height = screen_size()
    scale = min(1, MODEL_BOX[0] / width, MODEL_BOX[1] / height)
    VIEW = {"size": (width, height), "scale": scale}
    return VIEW


def shown_size():
    width, height = VIEW["size"]
    return round(width * VIEW["scale"]), round(height * VIEW["scale"])


def shown(x, y):
    """Screen coordinates as Codex sees them."""
    return round(x * VIEW["scale"]), round(y * VIEW["scale"])


def screenshot():
    # ImageMagick otherwise sizes its worker pool from host CPUs, which can exhaust a
    # container's thread allowance even though the container only has two CPUs.
    env = {**session_env(), "MAGICK_THREAD_LIMIT": "2", "OMP_NUM_THREADS": "2"}
    fit = [] if VIEW["scale"] == 1 else ["-resize", "{}x{}!".format(*shown_size())]
    return run("import", "-limit", "thread", "2", "-window", "root", *fit, "png:-", env=env).stdout


def active_window():
    env = session_env()
    try:
        wid = run("xdotool", "getactivewindow", env=env).stdout.decode().strip()
        name = run("xdotool", "getwindowname", wid, env=env).stdout.decode().strip()
        return name
    except subprocess.CalledProcessError:
        return ""


class TreeTimeout(Exception):
    pass


def accessible_elements(all_windows=False):
    """On-screen controls of the active window (or every window), with their centre points."""
    os.environ.update(session_env())
    try:
        import pyatspi
    except ImportError:
        return [], "accessibility tree unavailable"
    width, height = VIEW["size"]
    deadline = time.monotonic() + TREE_BUDGET_S
    visited = 0
    found = []

    def spent():
        return visited >= TREE_MAX_NODES or time.monotonic() > deadline or len(found) >= TREE_MAX_ELEMENTS

    def walk(node, depth):
        nonlocal visited
        if spent():
            return
        visited += 1
        try:
            states = node.getState()
            if depth > 1 and not states.contains(pyatspi.STATE_SHOWING):
                return  # hidden subtree (other tabs, closed menus, scrolled-off content)
            role = node.getRoleName()
            name = (node.name or "").strip()
            # Footnote links ("[12]") are noise on most pages.
            footnote = role == "link" and name.startswith("[") and name.endswith("]")
            if role in INTERACTIVE and not footnote and (name or role in ("entry", "password text", "text")):
                box = node.queryComponent().getExtents(pyatspi.DESKTOP_COORDS)
                if box.width > 0 and box.height > 0 and 0 <= box.x < width and 0 <= box.y < height:
                    if role == "text" and not states.contains(pyatspi.STATE_EDITABLE):
                        pass  # plain text: the screenshot covers it
                    else:
                        extra = []
                        if states.contains(pyatspi.STATE_FOCUSED):
                            extra.append("focused")
                        if states.contains(pyatspi.STATE_CHECKED):
                            extra.append("checked")
                        if not states.contains(pyatspi.STATE_ENABLED):
                            extra.append("disabled")
                        found.append({
                            "role": role, "name": name[:80],
                            "x": box.x + box.width // 2, "y": box.y + box.height // 2,
                            "state": extra,
                        })
            # Containers that manage their own children (a spreadsheet's million cells, long lists)
            # are data, not controls: walking them is one round-trip per child and never ends.
            if states.contains(pyatspi.STATE_MANAGES_DESCENDANTS):
                return
            for i in range(min(node.childCount, TREE_MAX_CHILDREN)):
                if spent():
                    return
                walk(node.getChildAtIndex(i), depth + 1)
        except TreeTimeout:
            raise
        except Exception:
            return  # nodes vanish while we read them; skip

    # Backstop: a single call into a busy app can block; the list comes back regardless.
    def timed_out(signum, frame):
        raise TreeTimeout()

    previous = signal.signal(signal.SIGALRM, timed_out)
    signal.setitimer(signal.ITIMER_REAL, TREE_BUDGET_S + 1)
    cut = False
    try:
        for app in pyatspi.Registry.getDesktop(0):
            if app is None:
                continue
            try:
                for frame in app:
                    if frame is None:
                        continue
                    if all_windows or frame.getState().contains(pyatspi.STATE_ACTIVE):
                        walk(frame, 0)
            except TreeTimeout:
                raise
            except Exception:
                continue
    except TreeTimeout:
        cut = True
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)
        signal.signal(signal.SIGALRM, previous)
    note = " (list cut short)" if cut or spent() else ""
    return found, note


ELEMENTS = []  # from the last observe, so actions can say element=N (real screen coordinates)


def screen_line():
    return "Screen {}x{}. Active window: {}.".format(*shown_size(), active_window() or "(none)")


def observe(all_windows=False):
    global ELEMENTS
    ELEMENTS, note = accessible_elements(all_windows)
    lines = [screen_line()]
    if ELEMENTS:
        lines.append(f"Controls{note} — [n] role \"name\" (x,y):")
        for i, e in enumerate(ELEMENTS, 1):
            state = f" [{', '.join(e['state'])}]" if e["state"] else ""
            x, y = shown(e["x"], e["y"])
            lines.append(f"[{i}] {e['role']} \"{e['name']}\" ({x},{y}){state}")
    else:
        lines.append(f"No controls listed{note}; use the screenshot's coordinates.")
    return "\n".join(lines)


# ---- acting -------------------------------------------------------------------------------

def xdo(*args):
    run("xdotool", *[str(a) for a in args], env=session_env())


def point(args):
    if args.get("element") is not None:
        n = int(args["element"])
        if not 1 <= n <= len(ELEMENTS):
            raise ValueError(f"no element {n} in the last observe; call observe again")
        return ELEMENTS[n - 1]["x"], ELEMENTS[n - 1]["y"]
    if args.get("x") is None or args.get("y") is None:
        raise ValueError("give element (from observe) or x and y")
    x, y = int(args["x"]), int(args["y"])
    width, height = shown_size()
    if not (0 <= x < width and 0 <= y < height):
        raise ValueError(f"({x},{y}) is off the {width}x{height} screen")
    # Codex's coordinates to the real screen's, kept on it.
    real_width, real_height = VIEW["size"]
    scale = VIEW["scale"]
    return min(round(x / scale), real_width - 1), min(round(y / scale), real_height - 1)


BUTTONS = {"left": 1, "middle": 2, "right": 3}


def click(args):
    x, y = point(args)
    button = BUTTONS[args.get("button", "left")]
    xdo("mousemove", "--sync", x, y)
    xdo("click", "--repeat", int(args.get("clicks", 1)), "--delay", 80, button)
    emit("click", x=x, y=y)
    return "clicked ({},{})".format(*shown(x, y))


def type_text(args):
    text = args["text"]
    xdo("type", "--delay", 12, "--", text)
    if args.get("enter"):
        xdo("key", "Return")
    emit("type")
    return f"typed {len(text)} characters"


def key(args):
    keys = args["keys"].split()
    xdo("key", "--delay", 60, *keys)
    emit("type")
    return f"pressed {' '.join(keys)}"


def scroll(args):
    x, y = point(args) if args.get("element") is not None or args.get("x") is not None else (VIEW["size"][0] // 2, VIEW["size"][1] // 2)
    direction = args.get("direction", "down")
    button = {"up": 4, "down": 5, "left": 6, "right": 7}[direction]
    xdo("mousemove", "--sync", x, y)
    xdo("click", "--repeat", int(args.get("amount", 5)), "--delay", 30, button)
    return "scrolled {} at ({},{})".format(direction, *shown(x, y))


def drag(args):
    x1, y1 = point({"x": args["from_x"], "y": args["from_y"]})
    x2, y2 = point({"x": args["to_x"], "y": args["to_y"]})
    # Like a hand: press, nudge past the drag threshold, glide in small steps, rest on the target,
    # release. Browsers (HTML drag and drop) and file managers ignore a drag that jumps there.
    steps = max(12, min(40, int(((x2 - x1) ** 2 + (y2 - y1) ** 2) ** 0.5 / 20)))
    moves = ["mousemove", x1, y1, "mousedown", 1, "sleep", 0.15, "mousemove", x1 + 6, y1 + 6, "sleep", 0.1]
    for i in range(1, steps + 1):
        moves += ["mousemove", x1 + (x2 - x1) * i // steps, y1 + (y2 - y1) * i // steps, "sleep", 0.02]
    moves += ["sleep", 0.25, "mouseup", 1]
    xdo(*moves)
    return "dragged ({},{}) → ({},{})".format(*shown(x1, y1), *shown(x2, y2))


def launch(args):
    cmd = args["command"]
    spawn(["bash", "-lc", cmd], session_env(), open(LOG, "ab"))
    time.sleep(float(args.get("wait", 3)))
    return f"started: {cmd}"


def windows(args):
    out = run("wmctrl", "-lG", env=session_env(), check=False).stdout.decode()
    rows = []
    for line in out.splitlines():
        parts = line.split(None, 7)
        if len(parts) == 8 and parts[1] != "-1":  # skip panel and desktop
            wid, _, x, y, w, h, _, title = parts
            rows.append(f"{wid} \"{title}\" at ({x},{y}) {w}x{h}")
    return "\n".join(rows) or "no windows open"


def focus(args):
    target = args["window"]
    flag = ["-i", "-a"] if target.startswith("0x") else ["-a"]
    if run("wmctrl", *flag, target, env=session_env(), check=False).returncode:
        raise ValueError(f"no window matching {target!r}; see windows")
    return f"focused {target}"


def clipboard(args):
    env = session_env()
    if "text" in args:
        subprocess.run(["xclip", "-selection", "clipboard"], input=args["text"].encode(), env=env, check=True)
        return "clipboard set"
    out = run("xclip", "-selection", "clipboard", "-o", env=env, check=False).stdout.decode(errors="replace")
    return out[:20000] or "(clipboard is empty)"


def wait(args):
    time.sleep(min(float(args.get("seconds", 2)), 30))
    return "waited"


# ---- other computers (over SSH) -------------------------------------------------------------
#
# `machine` names an SSH host of the person's (~/.ssh/config). One SSH connection per machine,
# kept for this MCP process, runs runtime/desktop-agent.py there with that machine's own Python
# (sent over the connection, never installed), which answers one JSON request per line.
# Machines on the person's tailnet are reached through runtime/tailnet (ProxyCommand).
# Codex sees one screen of the machine at a time, scaled into MODEL_BOX like dot's own.

AGENT_SOURCE = Path(__file__).resolve().parent / "desktop-agent.py"
SSH_OPTIONS = [
    "-o", "BatchMode=yes", "-o", "ConnectTimeout=20", "-o", "ServerAliveInterval=15",
    "-o", "ServerAliveCountMax=3", "-o", "StrictHostKeyChecking=accept-new",
]
# The system Python first: it's the one with the desktop's PyGObject (a Homebrew or pyenv one
# earlier on PATH usually lacks it).
BOOT = (
    'py=$(command -v /usr/bin/python3 || command -v python3) || { echo "no python3" >&2; exit 127; }; '
    "exec \"$py\" -u -c 'import sys; exec(sys.stdin.read(int(sys.stdin.readline())))'"
)
class Machine:
    def __init__(self, host):
        self.host = host
        self.proc = None
        self.screens = []  # as last shown
        self.screen = None  # index of the screen Codex sees
        self.scale = 1
        self.elements = []
        self.windows = []
        self.pointer = None  # where dot last left the pointer, to notice someone else moving it

    def connect(self):
        self.proc = subprocess.Popen(
            ["ssh", *SSH_OPTIONS, self.host, BOOT], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
            stderr=subprocess.PIPE, text=True, bufsize=1,
        )
        source = AGENT_SOURCE.read_text()
        self.proc.stdin.write(f"{len(source)}\n{source}")
        self.proc.stdin.flush()

    def ask(self, op, **fields):
        for attempt in (1, 2):
            if self.proc is None or self.proc.poll() is not None:
                self.connect()
            try:
                self.proc.stdin.write(json.dumps({"op": op, **fields}) + "\n")
                self.proc.stdin.flush()
                line = self.proc.stdout.readline()
            except BrokenPipeError:
                line = ""
            if line:
                reply = json.loads(line)
                if not reply.pop("ok"):
                    raise ValueError(f"{self.host}: {reply['error']}")
                return reply
            self.proc.wait(timeout=5)
            detail = self.proc.stderr.read().strip()[-600:]
            self.proc = None
            if attempt == 2 or "Permission denied" in detail or "Could not resolve" in detail:
                raise ValueError(f"can't reach {self.host} over SSH: {detail or 'connection closed'}")

    # Screens and coordinates ----------------------------------------------------------------

    def look(self, choose=None):
        """The machine's screens, windows and pointer; picks the screen Codex is shown."""
        state = self.ask("layout")
        if state["locked"]:
            raise ValueError(
                f"{self.host}'s screen is locked. Nothing can be done on it until the person unlocks "
                "it; tell them."
            )
        self.windows = state["windows"]
        screens = sorted(state["screens"], key=lambda s: (s["x"], s["y"]))  # 1 is the leftmost
        if choose is not None:
            if not 1 <= choose <= len(screens):
                raise ValueError(f"{self.host} has {len(screens)} screen(s); pick 1–{len(screens)}")
            self.screen = choose - 1
        elif self.screen is None or self.screen >= len(screens) or screens != self.screens:
            # The active window's screen, else the first.
            active = next((w for w in self.windows if w["active"]), None)
            self.screen = 0
            if active:
                cx = active["frame"][0] + active["frame"][2] // 2
                cy = active["frame"][1] + active["frame"][3] // 2
                for i, s in enumerate(screens):
                    if s["x"] <= cx < s["x"] + s["width"] and s["y"] <= cy < s["y"] + s["height"]:
                        self.screen = i
        self.screens = screens
        s = screens[self.screen]
        self.scale = min(1, MODEL_BOX[0] / s["width"], MODEL_BOX[1] / s["height"])
        return state

    def span(self):
        """Every screen together: the virtual pointer's range."""
        return [max(s["x"] + s["width"] for s in self.screens), max(s["y"] + s["height"] for s in self.screens)]

    def shown_size(self):
        s = self.screens[self.screen]
        return round(s["width"] * self.scale), round(s["height"] * self.scale)

    def shown(self, x, y):
        s = self.screens[self.screen]
        return round((x - s["x"]) * self.scale), round((y - s["y"]) * self.scale)

    def point(self, args):
        if args.get("element") is not None:
            n = int(args["element"])
            if not 1 <= n <= len(self.elements):
                raise ValueError(f"no element {n} in the last observe of {self.host}; call observe again")
            return self.elements[n - 1]["x"], self.elements[n - 1]["y"]
        if args.get("x") is None or args.get("y") is None:
            raise ValueError("give element (from observe) or x and y")
        x, y = int(args["x"]), int(args["y"])
        width, height = self.shown_size()
        if not (0 <= x < width and 0 <= y < height):
            raise ValueError(f"({x},{y}) is off the {width}x{height} screen")
        s = self.screens[self.screen]
        return (min(s["x"] + round(x / self.scale), s["x"] + s["width"] - 1),
                min(s["y"] + round(y / self.scale), s["y"] + s["height"] - 1))

    def screenshot(self):
        """The shown screen, cut out of the machine's whole-desktop screenshot and scaled."""
        from PIL import Image
        import io
        whole = Image.open(io.BytesIO(base64.b64decode(self.ask("screenshot")["png"])))
        left = min(s["x"] for s in self.screens)
        top = min(s["y"] for s in self.screens)
        span = self.span()
        ratio = whole.width / (span[0] - left)  # above 1 on a scaled (HiDPI) desktop
        s = self.screens[self.screen]
        box = [round((s["x"] - left) * ratio), round((s["y"] - top) * ratio),
               round((s["x"] - left + s["width"]) * ratio), round((s["y"] - top + s["height"]) * ratio)]
        picture = whole.crop(box).convert("RGB").resize(self.shown_size(), Image.LANCZOS)
        out = io.BytesIO()
        picture.save(out, "PNG", optimize=True)
        return out.getvalue()

    # Reading the screen ---------------------------------------------------------------------

    def screen_line(self):
        s = self.screens[self.screen]
        active = next((w["title"] for w in self.windows if w["active"]), "(none)")
        line = "{}, screen {} of {}: {}x{}. Active window: {}.".format(
            self.host, self.screen + 1, len(self.screens), *self.shown_size(), active)
        others = [f"{i + 1} ({o['width']}x{o['height']}, {o['name']})" for i, o in enumerate(self.screens) if i != self.screen]
        if others:
            line += f" Other screens: {', '.join(others)}; see one with observe screen=N."
        return line

    def observe(self, all_windows=False):
        reply = self.ask("controls", windows=self.windows, all_windows=bool(all_windows))
        s = self.screens[self.screen]
        self.elements = [e for e in reply["controls"]
                         if s["x"] <= e["x"] < s["x"] + s["width"] and s["y"] <= e["y"] < s["y"] + s["height"]]
        lines = [self.screen_line()]
        if self.elements:
            lines.append(f"Controls{reply['note']} — [n] role \"name\" (x,y):")
            for i, e in enumerate(self.elements, 1):
                state = f" [{', '.join(e['state'])}]" if e["state"] else ""
                lines.append("[{}] {} \"{}\" ({},{}){}".format(i, e["role"], e["name"], *self.shown(e["x"], e["y"]), state))
        else:
            lines.append(
                f"No controls listed{reply['note']} (this window doesn't share them); "
                "use the screenshot's coordinates."
            )
        return "\n".join(lines)

    # Acting ---------------------------------------------------------------------------------

    def act(self, action, **fields):
        reply = self.ask("act", action=action, span=self.span(), **fields)
        return reply["result"]

    def click(self, args):
        x, y = self.point(args)
        self.act("click", at=[x, y], button=args.get("button", "left"), clicks=int(args.get("clicks", 1)))
        self.pointer = (x, y)
        return "clicked ({},{})".format(*self.shown(x, y))

    def type_text(self, args):
        how = self.act("type", text=args["text"], enter=bool(args.get("enter")))
        return f"{how} {len(args['text'])} characters"

    def key(self, args):
        self.act("key", keys=args["keys"])
        return f"pressed {args['keys']}"

    def scroll(self, args):
        if args.get("element") is not None or args.get("x") is not None:
            x, y = self.point(args)
        else:
            s = self.screens[self.screen]
            x, y = s["x"] + s["width"] // 2, s["y"] + s["height"] // 2
        direction = args.get("direction", "down")
        self.act("scroll", at=[x, y], direction=direction, amount=int(args.get("amount", 5)))
        self.pointer = (x, y)
        return "scrolled {} at ({},{})".format(direction, *self.shown(x, y))

    def drag(self, args):
        start = self.point({"x": args["from_x"], "y": args["from_y"]})
        end = self.point({"x": args["to_x"], "y": args["to_y"]})
        self.act("drag", **{"from": list(start), "to": list(end)})
        self.pointer = end
        return "dragged ({},{}) → ({},{})".format(*self.shown(*start), *self.shown(*end))

    def launch(self, args):
        self.ask("launch", command=args["command"])
        time.sleep(float(args.get("wait", 3)))
        return f"started on {self.host}: {args['command']}"

    def list_windows(self, args):
        rows = []
        for w in self.windows:
            x, y, width, height = w["frame"]
            screen = next((i + 1 for i, s in enumerate(self.screens)
                           if s["x"] <= x + width // 2 < s["x"] + s["width"]), "?")
            flags = (" [active]" if w["active"] else "") + (" [minimized]" if w["minimized"] else "")
            rows.append(f"{w['id']} \"{w['title']}\" ({w['app']}) on screen {screen}, {width}x{height}{flags}")
        return "\n".join(rows) or "no windows open"

    def focus(self, args):
        found = self.ask("focus", window=args["window"])
        self.screen = None  # show the screen it's on
        return f"focused \"{found['title']}\""

    def clipboard(self, args):
        if "text" in args:
            self.ask("clipboard", text=args["text"])
            return "clipboard set"
        return self.ask("clipboard")["text"][:20000] or "(clipboard is empty)"


MACHINES = {}
MACHINE_TOOLS = {
    "click": Machine.click, "type": Machine.type_text, "key": Machine.key, "scroll": Machine.scroll,
    "drag": Machine.drag, "launch": Machine.launch, "windows": Machine.list_windows,
    "focus": Machine.focus, "clipboard": Machine.clipboard, "wait": lambda m, a: wait(a),
}


def call_machine(host, name, args):
    machine = MACHINES.setdefault(host, Machine(host))
    lines = []
    if name == "windows":
        machine.look()
        return [{"type": "text", "text": machine.list_windows(args)}]
    known = machine.screens
    state = machine.look(args.get("screen") if name in ("observe", "screenshot") else None)
    if name not in ("observe", "screenshot", "windows", "clipboard", "wait"):
        # Someone moved the mouse since dot last did: the person is at that computer.
        at = tuple(state["pointer"])
        moved = machine.pointer and max(abs(at[0] - machine.pointer[0]), abs(at[1] - machine.pointer[1])) > 3
        machine.pointer = at
        if moved:
            return [{"type": "text", "text": (
                f"Someone is using {host} right now (its mouse moved since your last action), so "
                "nothing was done for this call. Don't fight them for it: `wait` and try again, or "
                "reply to the person with what's left to do."
            )}]
    if name in AIMED and known and machine.screens != known:
        lines.append(
            f"{host}'s screens changed since your last screenshot, so nothing was done for this "
            "call; here's the screen now, decide again."
        )
        name = "observe"
    if name not in ("observe", "screenshot"):
        lines.append(MACHINE_TOOLS[name](machine, args))
        if name not in SHOW_AFTER:
            return [{"type": "text", "text": "\n".join(lines)}]
        time.sleep(0.6)
        machine.look()
    lines.append(machine.screen_line() if name == "screenshot" else machine.observe(bool(args.get("all_windows"))))
    data = base64.b64encode(machine.screenshot()).decode()
    return [
        {"type": "text", "text": "\n".join(lines)},
        {"type": "image", "data": data, "mimeType": "image/png"},
    ]


def check(host):
    """`desktop check <host>`: what dot can do on that machine, and what's missing."""
    if not host:
        sys.exit("usage: desktop check <ssh host>")
    try:
        found = Machine(host).ask("info")
    except ValueError as error:
        sys.exit(f"error: {error}")
    print(f"{host} ({found['host']}): {found['desktop'] or 'no desktop'} on {found['session'] or '?'}")
    if found["missing"]:
        print("Missing (the person has to do these on that machine):")
        for item in found["missing"]:
            print(f"- {item}")
    else:
        print("Ready: use the desktop tools with machine=" + json.dumps(host) + ".")
    if found["locked"]:
        print("Its screen is locked right now; the person has to unlock it first.")
    if not found["accessibility"]:
        print("No accessibility tree: controls won't be listed, use screenshot coordinates.")


