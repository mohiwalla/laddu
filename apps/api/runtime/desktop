AIMED = {"click", "scroll", "drag"}


def call_tool(name, args):
    if name not in TOOLS:
        raise ValueError(f"unknown tool {name}")
    if args.get("machine"):
        return call_machine(str(args["machine"]).strip(), name, args)
    handed_back = False
    if person_in_control():
        deadline = time.monotonic() + HANDBACK_WAIT_S
        while person_in_control() and time.monotonic() < deadline:
            time.sleep(1)
        if person_in_control():
            return [{"type": "text", "text": (
                "The person you're working for has taken control of your computer and is using it. "
                "Don't act on it now: call `wait` to keep waiting for them to hand it back, or reply "
                "to them with what's left to do."
            )}]
        handed_back = True
    started = start()
    touch()
    lines = ["(desktop started)"] if started else []
    if handed_back:
        lines.append(
            "The person had taken control and has just handed it back. The screen may have changed, "
            "so nothing was done for this call; here's the screen now, decide again."
        )
        name = "observe"
    if VIEW is None:  # this process hasn't sent a screenshot yet
        look()
    if name in AIMED and screen_size() != VIEW["size"]:
        lines.append(
            "The screen changed size (the person's browser window did) since your last screenshot, "
            "so nothing was done for this call; here's the screen now, decide again."
        )
        name = "observe"
    if name not in ("observe", "screenshot"):
        lines.append(TOOLS[name][3](args))
        if name not in SHOW_AFTER:
            return [{"type": "text", "text": "\n".join(lines)}]
        time.sleep(0.6)  # let the screen settle
    look()
    if name == "screenshot":
        lines.append(screen_line())
    else:
        lines.append(observe(bool(args.get("all_windows"))))
    data = base64.b64encode(screenshot()).decode()
    return [
        {"type": "text", "text": "\n".join(lines)},
        {"type": "image", "data": data, "mimeType": "image/png"},
    ]


def mcp():
    def send(message):
        sys.stdout.write(json.dumps(message) + "\n")
        sys.stdout.flush()

    for line in sys.stdin:
        if not line.strip():
            continue
        try:
            request = json.loads(line)
        except json.JSONDecodeError:
            continue
        method, rid = request.get("method"), request.get("id")
        if rid is None:
            continue  # notifications
        params = request.get("params") or {}
        if method == "initialize":
            result = {
                "protocolVersion": params.get("protocolVersion", "2025-06-18"),
                "capabilities": {"tools": {}},
                "serverInfo": {"name": "desktop", "version": "0.1"},
            }
        elif method == "tools/list":
            result = {"tools": [
                {"name": name, "description": desc,
                 "inputSchema": {"type": "object", "properties": props, "required": required}}
                for name, (desc, props, required, _) in TOOLS.items()
            ]}
        elif method == "tools/call":
            try:
                result = {"content": call_tool(params["name"], params.get("arguments") or {})}
            except (ValueError, KeyError, subprocess.CalledProcessError) as error:
                detail = error.stderr.decode(errors="replace").strip() if isinstance(error, subprocess.CalledProcessError) and error.stderr else str(error)
                result = {"content": [{"type": "text", "text": f"error: {detail}"}], "isError": True}
        elif method == "ping":
            result = {}
        else:
            send({"jsonrpc": "2.0", "id": rid, "error": {"code": -32601, "message": f"unknown method {method}"}})
            continue
        send({"jsonrpc": "2.0", "id": rid, "result": result})


def link(reason):
    """Asks the bot (which signs the links) to send them to the person; see agent/bot-api.ts."""
    api, caller = os.environ.get("DOT_API"), os.environ.get("DOT_CALLER")
    if not api or not caller:
        sys.exit("error: links aren't available here (no connection to the bot in this turn).")
    request = urllib.request.Request(
        f"{api}/desktop/link", method="POST", data=json.dumps({"reason": reason}).encode(),
        headers={"x-dot-caller": caller, "content-type": "application/json"},
    )
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            print(json.load(response)["text"])
    except urllib.error.HTTPError as error:
        try:
            sys.exit(f"error: {json.load(error)['text']}")
        except (ValueError, KeyError):
            sys.exit(f"error: the bot answered {error.code}")


def exec_command(args):
    if args[:1] == ["--"]:
        args = args[1:]
    if not args:
        sys.exit("usage: desktop exec [--] <command> [args...]")
    if person_in_control():
        sys.exit("error: the person has control; use the desktop wait tool until they hand it back.")
    start()
    touch()
    try:
        result = subprocess.run(args, env=session_env())
    except FileNotFoundError:
        sys.exit(f"error: command not installed: {args[0]}")
    sys.exit(result.returncode if result.returncode >= 0 else 128 - result.returncode)


def main(args):
    if args in (["--help"], ["-h"], ["help"]):
        print(__doc__.strip())
        return
    command = args[0] if args else "status"
    if command == "link":
        link(" ".join(args[1:]))
    elif command == "start":
        print("started" if start() else "already running")
    elif command == "stop":
        stop()
        print("stopped")
    elif command == "status":
        print(status())
    elif command == "exec":
        exec_command(args[1:])
    elif command == "events":
        events()
    elif command == "control":
        control(args[1] if len(args) > 1 else "")
    elif command == "mcp":
        mcp()
    elif command == "check":
        check(args[1] if len(args) > 1 else "")
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main(sys.argv[1:])
