# dot settings: copy to .env and fill in the required ones (docs/SETUP.md). Always quote values.

# --- Slack ------------------------------------------------------------------------------------
SLACK_BOT_TOKEN="xoxb-..."         # Bot token, from installing the app (docs/SETUP.md)
SLACK_APP_TOKEN="xapp-..."         # App-level token with connections:write (Socket Mode)
# SLACK_USER_TOKEN="xoxp-..."      # User token; unused for now (for things like search:read)

# --- Who can use it ---------------------------------------------------------------------------
OWNER_SLACK_USER_ID="U0123456789"  # You (Slack profile > Copy member ID); default user, no special treatment
# ALLOWED_SLACK_USERS="*"          # "*" for everyone, or comma-separated member IDs; default: just the owner

# --- Model: Codex on your ChatGPT plan --------------------------------------------------------
CODEX_MODEL="gpt-6.1-sol"          # Model slug; `bun run login` lists the ones your plan can use
# CODEX_REASONING_EFFORT="medium"  # minimal | low | medium | high | xhigh
# CODEX_FAST="false"               # "true": fast mode, quicker but uses more of the plan's limits

# --- Runtime ----------------------------------------------------------------------------------
# CODEX_RUNTIME="docker"           # docker: a container per Slack user | host: this machine, yourself only
# ISOLATE_NETWORK="true"           # Docker: internet only, not this machine, the LAN or other containers
# CODEX_SANDBOX="workspace-write"  # Host only: read-only | workspace-write | danger-full-access
# CODEX_NETWORK="true"             # Host only: internet for Codex's shell

# --- dot's computer (Docker runtime) ---------------------------------------------------------
# DESKTOP="true"                   # A desktop per person that Codex can drive and they can watch
# DESKTOP_VIEWER_HOST="127.0.0.1"  # Where the viewer gateway listens
# DESKTOP_VIEWER_PORT="6900"
# DESKTOP_PUBLIC_URL="http://localhost:6900"  # What links point to: a tunnel or HTTPS domain on a server
# DESKTOP_IDLE_MINUTES="10"        # Stop a desktop after this long without actions or viewers

# --- Behaviour --------------------------------------------------------------------------------
# CODEX_WORKDIR="agent-home"       # Persona folder: AGENTS.md, AGENTS.local.md, skills
# CONTEXT_MESSAGES="20"            # Channel messages read before a top-level mention
# TRIGGER_EMOJI="robot_face"       # Reacting with this emoji to a message asks dot about it
# MEMORY_REVIEW_EVERY="3"          # Turns per person between memory and skill reviews; "0" = off

# --- Microsoft: Azure DevOps and Microsoft 365 (each person connects their own account) -------
MICROSOFT_CLIENT_ID=""             # Entra app client ID (docs/SETUP.md, "Microsoft"); empty = off
MICROSOFT_TENANT=""                # Directory (tenant) ID of that app; empty = "organizations"
MICROSOFT_GRAPH_SCOPES=""          # Graph permissions asked at sign-in; empty = all (docs/SETUP.md)

# --- Storage ----------------------------------------------------------------------------------
# DATA_DIR=".data"                 # Credentials, sessions, schedules; one per workspace
# APP_NAME="slack-codex-bot"       # Name on the ChatGPT consent screen at `bun run login`
