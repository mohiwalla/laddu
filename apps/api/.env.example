# laddu settings: copy to .env and fill in the required ones (docs/SETUP.md). Always quote values.

# --- Slack ------------------------------------------------------------------------------------
SLACK_BOT_TOKEN="xoxb-..."         # Bot token, from installing the app (docs/SETUP.md)
SLACK_APP_TOKEN="xapp-..."         # App-level token with connections:write (Socket Mode)
# SLACK_USER_TOKEN="xoxp-..."      # User token; unused for now (for things like search:read)
# SLACK_CLIENT_ID=""               # App's Client ID (Basic Information); with the secret, laddu can DM as people
# SLACK_CLIENT_SECRET=""           # App's Client Secret; also list DESKTOP_PUBLIC_URL/slack/oauth as a Redirect URL

# --- Who can use it ---------------------------------------------------------------------------
OWNER_SLACK_USER_ID="U0123456789"  # You (Slack profile > Copy member ID); default user, no special treatment
# ALLOWED_SLACK_USERS="*"          # "*" for everyone, or comma-separated member IDs; default: just the owner

# --- Agent: Codex on each person's ChatGPT plan, Claude Code on their Claude plan, or ---------
# --- OpenCode's free models -------------------------------------------------------------------
# LADDU_AGENT="codex"                # Default until people pick on laddu's Home tab: codex | claude | opencode
# CODEX_MODEL="gpt-6.1-sol"        # Default model slug; unset: Codex's default for each person's plan
# CODEX_REASONING_EFFORT="medium"  # low | medium | high | xhigh
# CODEX_FAST="false"               # "true": fast mode, quicker but uses more of each plan's limits
# CLAUDE_MODEL="sonnet"            # Claude Code's default model; unset: Claude Code's own default
# CLAUDE_REASONING_EFFORT="medium" # low | medium | high | xhigh | max; unset: the model's default
# OPENCODE_MODEL="opencode/big-pickle"  # OpenCode's default (free, no sign-in)
# OPENCODE_REASONING_EFFORT="high" # The model's variant (low | high | max…); unset: its default

# --- Runtime ----------------------------------------------------------------------------------
# ISOLATE_NETWORK="true"           # Containers get internet only, not this machine, the LAN or other containers

# --- laddu's computer ---------------------------------------------------------------------------
# DESKTOP="true"                   # A desktop per person that Codex can drive and they can watch
# DESKTOP_VIEWER_HOST="127.0.0.1"  # Where the viewer gateway listens
# DESKTOP_VIEWER_PORT="6900"
# DESKTOP_PUBLIC_URL="http://localhost:6900"  # What links point to: a tunnel or HTTPS domain on a server
# DESKTOP_TAILNET_URL=""           # Optional: this machine on Tailscale, e.g. https://host.tailnet.ts.net, in front of
#                                  # DESKTOP_TAILNET_PORT: tailscale serve --bg --https=443 http://127.0.0.1:6901
# DESKTOP_TAILNET_PORT="6901"      # Default: DESKTOP_VIEWER_PORT + 1
# DESKTOP_TAILNET_USERS=""         # "U0123=name@github,…": Slack member → Tailscale login; their links point there,
#                                  # and it opens for them without a link
# DESKTOP_IDLE_MINUTES="10"        # Stop a desktop after this long without actions or viewers

# --- Behaviour --------------------------------------------------------------------------------
# CODEX_WORKDIR="agent-home"       # Persona folder: AGENTS.md, AGENTS.local.md, skills
# CODEX_LOCAL_DIR=""               # AGENTS.local.md and skills.local/ elsewhere; default: CODEX_WORKDIR
# CONTEXT_MESSAGES="20"            # Channel messages read before a top-level mention
# TRIGGER_EMOJI="robot_face"       # Reacting with this emoji to a message asks laddu about it
# MEMORY_REVIEW_EVERY="3"          # Turns per person between memory and skill reviews; "0" = off

# --- Microsoft: Azure DevOps and Microsoft 365 (each person connects their own account) -------
MICROSOFT_CLIENT_ID=""             # Entra app client ID (docs/SETUP.md, "Microsoft"); empty = off
MICROSOFT_TENANT=""                # Directory (tenant) ID of that app; empty = "organizations"
MICROSOFT_GRAPH_SCOPES=""          # Graph permissions asked at sign-in; empty = all (docs/SETUP.md)

# --- AWS CodeCommit (optional; profiles and credentials stay on the host) ------------------------
# CODECOMMIT_PROFILES="U0123456789=default,U0987654321=teammate" # Each Slack user gets their own host AWS CLI profile
# AWS_CLI_PATH="aws"                # Absolute CLI path if the service PATH doesn't include it

# --- Storage ----------------------------------------------------------------------------------
# DATA_DIR=".data"                 # Sessions, schedules, connected accounts
# LADDU_INSTANCE=""                  # Set by `laddu setup`: labels this bot's containers and volumes
