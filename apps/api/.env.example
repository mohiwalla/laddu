# Slack (Socket Mode). See docs/SETUP.md.
SLACK_BOT_TOKEN="xoxb-..."
SLACK_APP_TOKEN="xapp-..."
# User OAuth Token (xoxp-...), acts as you. Unused in V0; kept for things only user tokens can do (e.g. search:read).
# SLACK_USER_TOKEN="xoxp-..."

# You, the person running the bot. Find it in your Slack profile → ⋮ → Copy member ID.
# By default only you can use the bot; it gets no other special treatment.
OWNER_SLACK_USER_ID="U0123456789"

# Codex model slug. `bun run login` prints the ones your ChatGPT plan can use.
CODEX_MODEL="gpt-6.1-sol"

# Optional
# ALLOWED_SLACK_USERS="*"                # who can use the bot: "*" or comma-separated IDs; default: just the owner
# CODEX_RUNTIME="docker"                 # docker: one container per Slack user | host: runs on this machine
# CODEX_REASONING_EFFORT="medium"        # minimal | low | medium | high | xhigh
# ISOLATE_NETWORK="true"                 # docker: containers get internet only (not this machine or the LAN)
# CODEX_FAST="false"                     # true: fast mode (quicker, uses more of the plan's limits)
# CODEX_WORKDIR="agent-home"             # its AGENTS.md is the bot's persona (mounted read-only into containers)
# CONTEXT_MESSAGES="20"                  # channel messages read before a top-level mention
# TRIGGER_EMOJI="robot_face"             # react with this to a message to ask dot to handle it
# MEMORY_REVIEW_EVERY="3"                # turns per person between background memory reviews; "0" = off
# DATA_DIR=".data"                       # credentials, sessions, runtime config
# APP_NAME="slack-codex-bot"             # name shown on the ChatGPT consent screen
# Host runtime only:
# CODEX_SANDBOX="workspace-write"        # read-only | workspace-write | danger-full-access
# CODEX_NETWORK="true"                   # internet access for Codex's shell; containers are always networked
